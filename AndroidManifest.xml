<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to talk to the MUQADAS backend over HTTPS -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Runtime permission, requested only when you tap the mic -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Lets the app hand an alarm to the system clock app -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Package visibility: lets the app list launchable apps so you can open them by name -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:label="@string/app_name"
        android:theme="@style/Theme.Muqadas">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
